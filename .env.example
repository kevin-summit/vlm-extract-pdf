# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: models offered in the UI (first = default). Must support PDF file input.
OPENAI_MODELS=gpt-6.1-sol,gpt-6.1-terra,gpt-5.5

# Optional: max output tokens per extraction (raise for long documents)
OPENAI_MAX_OUTPUT_TOKENS=128000
